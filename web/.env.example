# 部署基路径：部署在域名根目录时使用 /；部署在子路径时使用 /your-subpath。
VITE_BASE_PATH=/

# API 源地址（协议 + 主机 + 端口），不要包含 /api/v1；留空表示与 API 同源部署。
# 开发环境留空时，Vite 会把 /api 代理到 VITE_API_PROXY_TARGET。
VITE_API_BASE_URL=

# 仅开发服务器使用：Vite 代理 /api 的目标地址。
VITE_API_PROXY_TARGET=http://127.0.0.1:8100

# 前端测试或演示需要 MSW 时显式开启；真实系统默认关闭。
# VITE_ENABLE_MSW=false
