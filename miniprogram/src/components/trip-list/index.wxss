.trip-item {
  padding: 27rpx 0;
  border-bottom: 1rpx solid #edf0f2;
}

.trip-hover {
  background: #f8f8f8;
}

.trip-top {
  display: flex;
  gap: 16rpx;
  align-items: center;
  justify-content: space-between;
}

.trip-plate {
  font-size: 35rpx;
  font-weight: 700;
  color: #20242c;
  letter-spacing: 1rpx;
}

.trip-status {
  font-size: 26rpx;
  font-weight: 600;
  color: #8c3b2e;
}

.trip-status.waiting {
  color: #606a75;
}

.trip-description {
  margin-top: 7rpx;
  color: #424a54;
}

.trip-next {
  margin-top: 9rpx;
  font-size: 25rpx;
  color: #606a75;
}

.trip-number {
  position: relative;
  padding-right: 30rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #8b929c;
  overflow-wrap: anywhere;
}

.arrow {
  position: absolute;
  right: 4rpx;
  bottom: 0;
  font-size: 37rpx;
  color: #a2a7af;
}
