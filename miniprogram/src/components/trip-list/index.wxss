.trip-list {
  overflow: hidden;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.trip-row {
  display: flex;
  gap: 24rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 160rpx;
  padding: 24rpx 28rpx;
  border-bottom: 1rpx solid var(--fc-border);
}

.trip-row--last {
  border-bottom: none;
}

.trip-row--hover {
  background: var(--fc-surface-muted);
}

.trip-main {
  flex: 1;
  min-width: 0;
}

.trip-plate {
  font-size: 40rpx;
  font-weight: 600;
  line-height: 1.25;
  color: var(--fc-text);
  letter-spacing: 0.5rpx;
  overflow-wrap: anywhere;
}

.trip-meta {
  margin-top: 8rpx;
  font-size: 26rpx;
  line-height: 1.4;
  color: var(--fc-text-secondary);
  overflow-wrap: anywhere;
}

.trip-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--fc-text-secondary);
  overflow-wrap: anywhere;
}

.trip-sep {
  margin: 0 8rpx;
  color: var(--fc-border-strong);
}

.trip-action {
  display: flex;
  flex: none;
  gap: 8rpx;
  align-items: center;
  min-height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  border-radius: 24rpx;
}

.trip-action--brand {
  background: var(--fc-brand);
}

.trip-action--accent {
  background: var(--fc-accent);
}

.trip-action--hover {
  opacity: 0.88;
}

.trip-action__arrow {
  font-size: 30rpx;
  line-height: 1;
  opacity: 0.9;
}

.trip-chevron {
  flex: none;
  font-size: 36rpx;
  line-height: 1;
  color: var(--fc-text-placeholder);
}
