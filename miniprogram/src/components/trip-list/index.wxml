<view class="trip-list">
  <view
    wx:for="{{trips}}"
    wx:key="id"
    class="trip-row {{index === trips.length - 1 ? 'trip-row--last' : ''}}"
    data-id="{{item.serverId}}"
    bindtap="open"
    hover-class="trip-row--hover"
    aria-role="button"
    aria-label="{{item.plate}}，{{item.material}}，{{item.supplier || '供应商待核实'}}"
  >
    <view class="trip-main">
      <view class="trip-plate">{{item.plate}}</view>
      <view class="trip-meta">{{item.material}}<text class="trip-sep">·</text>{{item.supplier || '供应商待核实'}}</view>
      <view wx:if="{{mode === 'ledger'}}" class="trip-sub">{{item.statusLabel}}<text class="trip-sep">·</text>{{item.createdAt}}</view>
    </view>
    <view
      wx:if="{{showAction && mode === 'workbench' && (kind === 'guard' || item.actionLabel)}}"
      class="trip-action trip-action--{{kind === 'guard' ? 'brand' : item.actionTone}}"
      data-id="{{item.serverId}}"
      catchtap="act"
      hover-class="trip-action--hover"
      aria-role="button"
    >
      <text>{{kind === 'guard' ? '核验放行' : item.actionLabel}}</text>
      <text class="trip-action__arrow">›</text>
    </view>
    <view wx:else class="trip-chevron" aria-hidden="true">›</view>
  </view>
</view>
