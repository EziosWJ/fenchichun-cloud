<view class="screen">
  <view class="demo-note">演示模式 · 数据仅保存在本机</view>
  <view class="workbench-heading heading-row">
    <view><view class="screen-title">{{roleName}}工作台</view><view class="subtle workbench-subtitle">{{role === 'warehouse' ? '查看车辆进度，办理现场作业' : '核对出厂依据，确认车辆放行'}}</view></view>
    <view wx:if="{{canSwitch}}" class="text-link" bindtap="switchRole">切换岗位</view>
  </view>
  <input class="search-input" value="{{query}}" placeholder="搜索车牌或流转单号" placeholder-class="field-placeholder" bindinput="search" confirm-type="search" />
  <view wx:if="{{role === 'guard'}}" class="filter-tabs">
    <view class="filter-tab {{!gateHistory ? 'selected' : ''}}" bindtap="showPending">待出厂</view>
    <view class="filter-tab {{gateHistory ? 'selected' : ''}}" bindtap="showHistory">已出厂</view>
  </view>
  <view class="list-heading heading-row">
    <view class="section-heading">{{role === 'warehouse' ? '进行中的车辆' : (gateHistory ? '已出厂记录' : '待出厂车辆')}}</view>
    <t-button wx:if="{{role === 'warehouse'}}" theme="primary" size="small" bindtap="register">登记流转单</t-button>
  </view>
  <loading-state wx:if="{{loading}}" text="正在加载车辆" />
  <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
  <empty-state wx:elif="{{!trips.length}}" text="{{query ? '没有匹配的车辆或流转单' : (role === 'warehouse' ? '暂无进行中的车辆' : (gateHistory ? '暂无已出厂记录' : '暂无待出厂车辆'))}}" />
  <trip-list wx:else trips="{{trips}}" kind="{{role}}" />
  <view wx:if="{{role === 'warehouse'}}" class="all-link" bindtap="allTrips">查看全部流转单　›</view>
</view>
