<view class="screen">
  <loading-state wx:if="{{loading}}" text="正在加载出厂依据" />
  <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
  <block wx:elif="{{trip}}">
    <view class="heading-row"><text class="plate">{{trip.plate}}</text><text class="status">{{type}}</text></view>
    <view class="exit-summary">{{trip.site}}　{{trip.material}}</view>
    <view class="subtle">流转单号：{{trip.id}}</view><view class="subtle">登记时间：{{trip.createdAt}}</view>
    <view class="notice exit-notice">{{trip.exitedAt ? '车辆已实际出厂，不能再次确认。' : (eligible ? '请核对现场车辆与下方出厂依据。' : '出厂依据尚不满足，请刷新并核对。')}}</view>
    <view class="detail-card"><view class="section-heading">出厂依据</view>
      <block wx:if="{{type === '拒收退厂'}}"><view class="detail-row"><text class="detail-label">拒收结论</text><text class="detail-value">{{inspection}}</text></view><view class="detail-row"><text class="detail-label">拒收原因</text><text class="detail-value">{{trip.inspection.reason}}</text></view><view class="detail-row"><text class="detail-label">确认人 / 时间</text><text class="detail-value">{{trip.inspection.operator}} {{trip.inspection.at}}</text></view><view wx:if="{{trip.inspection.values}}" class="detail-row"><text class="detail-label">检测数据</text><text class="detail-value">{{trip.inspection.values}}</text></view></block>
      <block wx:else><view class="detail-row"><text class="detail-label">出门证</text><text class="detail-value">{{trip.permit ? trip.permit.id : '尚未开具'}}</text></view><view class="detail-row"><text class="detail-label">审批状态</text><text class="detail-value">{{trip.permit && trip.permit.approvedAt ? '已审批' : '未审批'}}</text></view><view wx:if="{{trip.permit && trip.permit.approvedAt}}" class="detail-row"><text class="detail-label">审批时间</text><text class="detail-value">{{trip.permit.approvedAt}}</text></view></block>
      <view class="detail-row"><text class="detail-label">供应商</text><text class="detail-value">{{trip.supplier || '待核实'}}</text></view>
    </view>
    <view wx:if="{{type === '正常出厂'}}" class="detail-card"><view class="section-heading">检验与磅单</view><view class="detail-row"><text class="detail-label">检验结果</text><text class="detail-value">{{inspection}}</text></view><view wx:if="{{trip.inspection && trip.inspection.values}}" class="detail-row"><text class="detail-label">检测数据</text><text class="detail-value">{{trip.inspection.values}}</text></view><view class="detail-row"><text class="detail-label">实际卸粮地点</text><text class="detail-value">{{trip.unload ? trip.unload.location : '未确认'}}</text></view><view class="detail-row"><text class="detail-label">磅单</text><text class="detail-value">{{trip.ticket ? trip.ticket.id : '未关联'}}</text></view><block wx:if="{{trip.ticket}}"><view class="detail-row"><text class="detail-label">首磅 / 回磅</text><text class="detail-value">{{trip.ticket.firstAt}} / {{trip.ticket.secondAt}}</text></view><view class="detail-row"><text class="detail-label">毛重 / 皮重</text><text class="detail-value">{{trip.ticket.gross}} / {{trip.ticket.tare}}</text></view><view class="detail-row"><text class="detail-label">实际净重</text><text class="detail-value">{{trip.ticket.net || '未提供'}}</text></view><view class="detail-row"><text class="detail-label">扣减后重量</text><text class="detail-value">{{trip.ticket.deducted || '未提供'}}</text></view></block></view>
    <view wx:if="{{trip.exitedAt}}" class="detail-card"><view class="detail-row"><text class="detail-label">实际出厂时间</text><text class="detail-value">{{trip.exitedAt}}</text></view></view>
    <view wx:if="{{eligible}}" class="form-footer"><t-button block size="large" theme="primary" disabled="{{confirming}}" bindtap="confirmExit">确认实际出厂</t-button></view>
  </block>
</view>
