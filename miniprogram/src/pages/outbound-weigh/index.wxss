.weigh-page {
  position: relative;
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--fc-bg);
}

.weigh-page--fixed {
  height: 100vh;
  overflow: hidden;
}

.weigh-page--history {
  background: #fcf6f0;
}

.custom-nav {
  position: fixed;
  top: 0;
  right: 0;
  left: 0;
  z-index: 30;
  background:
    radial-gradient(95% 150% at 92% -18%, rgb(255 179 121 / 42%) 0%, rgb(255 231 210 / 0%) 62%),
    linear-gradient(180deg, #fcebda 0%, #fcefe2 100%);
}

.custom-nav__bar {
  position: relative;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
}

.custom-nav__back {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  margin-left: -24rpx;
  border-radius: 50%;
}

.custom-nav__back--hover {
  background: rgb(167 69 50 / 8%);
}

.custom-nav__arrow {
  width: 22rpx;
  height: 22rpx;
  border-bottom: 4rpx solid #25282b;
  border-left: 4rpx solid #25282b;
  transform: rotate(45deg);
}

.custom-nav__title {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #25282b;
  text-align: center;
  white-space: nowrap;
  pointer-events: none;
}

.nav-spacer {
  position: relative;
  z-index: 0;
  flex-shrink: 0;
}

.top-bg {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 0;
  display: block;
  width: 100%;
  height: 420rpx;
  pointer-events: none;
}

.weigh-page--history .top-bg {
  height: 760rpx;
  opacity: 0.52;
}

.history-backdrop {
  position: absolute;
  top: 0;
  right: 0;
  left: 0;
  z-index: 0;
  height: 1120rpx;
  overflow: hidden;
  pointer-events: none;
  background:
    radial-gradient(115% 46% at 88% -6%, rgb(255 171 110 / 55%) 0%, rgb(255 208 166 / 28%) 46%, rgb(255 230 208 / 0%) 74%),
    radial-gradient(85% 34% at 4% 7%, rgb(255 226 198 / 64%) 0%, rgb(255 236 216 / 0%) 72%),
    linear-gradient(180deg, #fcebda 0%, #fdf1e5 24%, #fdf6ef 58%, rgb(252 246 240 / 0%) 100%);
}

.history-backdrop__glow {
  position: absolute;
  border-radius: 50%;
  opacity: 0.62;
  filter: blur(4rpx);
}

.history-backdrop__glow--right {
  top: 150rpx;
  right: -140rpx;
  width: 520rpx;
  height: 400rpx;
  background: radial-gradient(ellipse, rgb(255 177 119 / 55%), rgb(255 220 190 / 0%) 70%);
  transform: rotate(-16deg);
}

.history-backdrop__glow--left {
  top: 310rpx;
  left: -190rpx;
  width: 600rpx;
  height: 330rpx;
  background: radial-gradient(ellipse, rgb(255 226 199 / 72%), rgb(255 238 220 / 0%) 72%);
  transform: rotate(11deg);
}

.weigh-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  width: 100%;
  max-width: 750px;
  min-height: 100vh;
  padding: 16rpx 24rpx calc(200rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(200rpx + env(safe-area-inset-bottom));
  margin: 0 auto;
}

.weigh-page--fixed .weigh-content {
  display: flex;
  flex-direction: column;
  height: 100%;
  min-height: 0;
  padding-bottom: calc(112rpx + constant(safe-area-inset-bottom));
  padding-bottom: calc(112rpx + env(safe-area-inset-bottom));
}

.weigh-main {
  min-width: 0;
}

.weigh-page--fixed .weigh-main {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-height: 0;
}

/* 顶部司机 / 车牌 */
.identity-bar {
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  gap: 20rpx;
  align-items: center;
  min-height: 104rpx;
  padding: 16rpx 24rpx;
  margin: 8rpx 0 16rpx;
  background: rgb(255 255 255 / 70%);
  border: 1rpx solid rgb(255 255 255 / 76%);
  border-radius: 24rpx;
  box-shadow: 0 8rpx 24rpx rgb(167 69 50 / 6%);
}

.identity-driver {
  display: flex;
  flex: 1;
  gap: 14rpx;
  align-items: center;
  min-width: 0;
}

.identity-driver-icon {
  flex-shrink: 0;
  width: 46rpx;
  height: 46rpx;
}

.identity-value {
  max-width: 100%;
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.2;
  color: var(--fc-text);
  letter-spacing: 1rpx;
  white-space: nowrap;
}

.identity-divider {
  flex-shrink: 0;
  width: 1rpx;
  height: 54rpx;
  background: rgb(167 69 50 / 16%);
}

.identity-plate {
  display: flex;
  flex-shrink: 0;
  gap: 8rpx;
  align-items: center;
  max-width: 300rpx;
  padding: 10rpx 18rpx;
  background: var(--fc-brand);
  border-radius: 12rpx;
}

.identity-plate-text {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 36rpx;
  font-weight: 700;
  line-height: 1.2;
  color: #fff;
  letter-spacing: 1rpx;
  white-space: nowrap;
}

/* 地磅读数 */
.reading-card {
  flex-shrink: 0;
  padding: 26rpx 28rpx 22rpx;
  text-align: center;
  background: linear-gradient(180deg, #fff 0%, #fffaf6 100%);
  border: 1rpx solid var(--fc-border);
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgb(98 48 32 / 5%);
}

.reading-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.reading-title {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.reading-icon {
  position: relative;
  flex-shrink: 0;
  width: 54rpx;
  height: 54rpx;
  color: var(--fc-brand);
}

.reading-icon__beam {
  position: absolute;
  top: 12rpx;
  left: 5rpx;
  width: 44rpx;
  height: 4rpx;
  background: currentcolor;
  border-radius: 2rpx;
}

.reading-icon__post {
  position: absolute;
  top: 12rpx;
  left: 25rpx;
  width: 4rpx;
  height: 34rpx;
  background: currentcolor;
  border-radius: 2rpx;
}

.reading-icon__pan {
  position: absolute;
  top: 23rpx;
  width: 16rpx;
  height: 10rpx;
  border: 3rpx solid currentcolor;
  border-top: none;
  border-radius: 0 0 12rpx 12rpx;
}

.reading-icon__pan--left {
  left: 0;
}

.reading-icon__pan--right {
  right: 0;
}

.reading-label {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--fc-text-secondary);
}

.mock-badge {
  flex-shrink: 0;
  padding: 4rpx 14rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--fc-warning-text);
  background: var(--fc-warning-soft);
  border-radius: 999rpx;
}

.reading-value-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-top: 0;
}

.reading-value {
  font-size: 120rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.02;
  color: var(--fc-brand);
  letter-spacing: -2rpx;
}

.reading-unit {
  margin-left: 10rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fc-text);
}

.reading-status-row {
  display: flex;
  gap: 14rpx;
  align-items: center;
  justify-content: center;
  margin-top: 8rpx;
}

.reading-status-line {
  width: 80rpx;
  height: 1rpx;
  background: rgb(167 69 50 / 20%);
}

.reading-status {
  display: inline-flex;
  gap: 8rpx;
  align-items: center;
  padding: 8rpx 18rpx;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 999rpx;
}

.reading-status--ok {
  color: var(--fc-success);
  background: var(--fc-success-soft);
}

.reading-status--warn {
  color: var(--fc-warning-text);
  background: var(--fc-warning-soft);
}

.reading-status--bad {
  color: var(--fc-error);
  background: var(--fc-error-soft);
}

/* 卡片通用 */
.action-card,
.result-card,
.qr-card {
  flex-shrink: 0;
  padding: 24rpx 28rpx;
  margin-top: 16rpx;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 24rpx;
  box-shadow: 0 14rpx 34rpx rgb(98 48 32 / 5%);
}

.action-card {
  text-align: center;
}

.action-heading,
.result-heading {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: center;
}

.pending-title,
.result-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--fc-text);
}

.pending-weight,
.result-net {
  margin-top: 8rpx;
  font-size: 96rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.1;
  color: var(--fc-brand);
  text-align: center;
  letter-spacing: -1rpx;
}

.pending-unit,
.result-unit {
  margin-left: 10rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--fc-text);
}

.action-hint {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--fc-text-secondary);
  text-align: center;
}

.action-card .primary-btn,
.result-card .primary-btn {
  margin-top: 18rpx;
}

.primary-btn {
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 96rpx;
  padding: 0 32rpx;
  margin-top: 18rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.2;
  color: #fff;
  background: var(--fc-brand);
  border: none;
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgb(167 69 50 / 18%);
}

.primary-btn::after {
  border: none;
}

.primary-btn:active {
  background: var(--fc-brand-pressed);
}

.primary-btn--disabled {
  box-shadow: none;
  opacity: 0.45;
}

/* 空闲 / 处理状态 */
.idle-card {
  display: flex;
  gap: 20rpx;
  align-items: center;
  text-align: left;
}

.idle-copy {
  flex: 1;
  min-width: 0;
}

.idle-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--fc-text);
}

.idle-desc {
  display: block;
  margin-top: 4rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--fc-text-secondary);
}

.action-card .idle-btn {
  flex-shrink: 0;
  width: auto;
  min-width: 168rpx;
  min-height: 88rpx;
  padding: 0 28rpx;
  margin: 0;
}

.processing-card {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  align-items: center;
}

.processing-card .action-hint {
  margin-top: 0;
}

/* 二维码 */
.card-heading {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.card-heading__icon {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  line-height: 1.25;
  color: var(--fc-text);
}

.qr-frame {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 50vw;
  max-width: 380rpx;
  height: 50vw;
  max-height: 380rpx;
  margin: 14rpx auto 0;
  background: #fff;
  border: 1rpx solid #f0e6dd;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 16rpx rgb(37 40 43 / 8%);
}

.qr-image {
  width: 94%;
  height: 94%;
}

.qr-corner {
  position: absolute;
  z-index: 1;
  width: 32rpx;
  height: 32rpx;
  border-color: var(--fc-accent);
  border-style: solid;
}

.qr-corner--tl {
  top: -2rpx;
  left: -2rpx;
  border-width: 5rpx 0 0 5rpx;
  border-radius: 12rpx 0 0;
}

.qr-corner--tr {
  top: -2rpx;
  right: -2rpx;
  border-width: 5rpx 5rpx 0 0;
  border-radius: 0 12rpx 0 0;
}

.qr-corner--bl {
  bottom: -2rpx;
  left: -2rpx;
  border-width: 0 0 5rpx 5rpx;
  border-radius: 0 0 0 12rpx;
}

.qr-corner--br {
  right: -2rpx;
  bottom: -2rpx;
  border-width: 0 5rpx 5rpx 0;
  border-radius: 0 0 12rpx;
}

.qr-refresh {
  position: absolute;
  top: 50%;
  left: 50%;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 96rpx;
  height: 96rpx;
  background: rgb(255 255 255 / 96%);
  border: 1rpx solid var(--fc-border);
  border-radius: 50%;
  box-shadow: 0 8rpx 22rpx rgb(98 48 32 / 16%);
  transform: translate(-50%, -50%);
  transition: transform 120ms ease, opacity 120ms ease;
}

.qr-refresh:active {
  opacity: 0.82;
  transform: translate(-50%, -50%) scale(0.96);
}

.qr-refresh-icon {
  width: 48rpx;
  height: 48rpx;
}

.qr-expiry {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: var(--fc-text-secondary);
}

.qr-expiry__value {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  color: var(--fc-brand);
}

.qr-weight {
  display: flex;
  gap: 10rpx;
  align-items: baseline;
  justify-content: center;
  padding: 14rpx 20rpx;
  margin-top: 14rpx;
  background: #fbf1e7;
  border-radius: 18rpx;
}

.qr-weight__label {
  font-size: 26rpx;
  color: var(--fc-text-secondary);
}

.qr-weight__value {
  font-size: 38rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: var(--fc-brand);
}

.qr-weight__unit {
  margin-left: 4rpx;
  font-size: 22rpx;
  font-weight: 500;
  color: var(--fc-text-secondary);
}

/* 完成结果 */
.result-row {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
  justify-content: space-between;
  padding-top: 16rpx;
  margin-top: 14rpx;
  font-size: 26rpx;
  border-top: 1rpx solid var(--fc-border);
}

.result-k {
  flex-shrink: 0;
  color: var(--fc-text-secondary);
}

.result-v {
  font-weight: 500;
  color: var(--fc-text);
  text-align: right;
  word-break: break-all;
}

.result-message {
  padding: 14rpx 18rpx;
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--fc-warning-text);
  text-align: left;
  background: var(--fc-warning-soft);
  border-radius: 16rpx;
}

/* 历史记录 */
.history-filters {
  display: flex;
  gap: 36rpx;
  align-items: center;
  margin: 4rpx 0 38rpx;
}

.history-range {
  box-sizing: border-box;
  display: flex;
  flex: 0 0 252rpx;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  padding: 0 16rpx;
  background: rgb(255 255 255 / 78%);
  border: 1rpx solid rgb(255 255 255 / 82%);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 26rpx rgb(167 105 68 / 7%);
}

.history-range__icon {
  flex: none;
  width: 36rpx;
  height: 36rpx;
}

.history-range__label {
  overflow: hidden;
  text-overflow: ellipsis;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  color: #3f3b38;
  white-space: nowrap;
}

.history-range__caret {
  flex: none;
  width: 0;
  height: 0;
  margin-left: 2rpx;
  border-top: 12rpx solid #3f3b38;
  border-right: 8rpx solid transparent;
  border-left: 8rpx solid transparent;
  border-radius: 2rpx;
}

.history-type-tabs {
  box-sizing: border-box;
  display: flex;
  flex: 1;
  height: 72rpx;
  padding: 5rpx;
  background: rgb(255 255 255 / 78%);
  border: 1rpx solid rgb(255 255 255 / 82%);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 26rpx rgb(167 105 68 / 7%);
}

.history-type-tab {
  position: relative;
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #494440;
  border-radius: 999rpx;
}

.history-type-tab + .history-type-tab::before {
  position: absolute;
  top: 50%;
  left: 0;
  width: 1rpx;
  height: 26rpx;
  content: '';
  background: rgb(167 69 50 / 12%);
  transform: translateY(-50%);
}

.history-type-tab.is-active {
  font-weight: 700;
  color: #fff;
  background: linear-gradient(180deg, #c95030 0%, #a74532 100%);
  box-shadow: 0 8rpx 18rpx rgb(167 69 50 / 24%);
}

.history-type-tab.is-active::before,
.history-type-tab.is-active + .history-type-tab::before {
  display: none;
}

.history-filters--custom {
  margin-bottom: 12rpx;
}

.history-custom-range {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 6rpx;
  margin: 0 0 18rpx;
  background: rgb(255 255 255 / 82%);
  border: 1rpx solid rgb(255 255 255 / 90%);
  border-radius: 24rpx;
  box-shadow: 0 10rpx 24rpx rgb(167 105 68 / 6%);
}

.history-date-picker {
  display: flex;
  flex: none;
  min-width: 0;
}

.history-date-picker__inner {
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 8rpx 12rpx;
  border-radius: 18rpx;
}

.history-date-picker__inner--hover {
  background: rgb(167 69 50 / 6%);
}

.history-date-picker--start .history-date-picker__inner {
  align-items: flex-end;
}

.history-date-picker--start .history-date-picker__head {
  justify-content: flex-end;
}

.history-date-picker--start .history-date-picker__value {
  text-align: right;
}

.history-date-picker__head {
  display: flex;
  gap: 8rpx;
  align-items: center;
}

.history-date-picker__icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.history-date-picker__label {
  font-size: 24rpx;
  line-height: 1.2;
  color: #8a7d73;
}

.history-date-picker__value {
  display: block;
  margin-top: 2rpx;
  font-size: 28rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  line-height: 1.2;
  color: #25282b;
  white-space: nowrap;
}

.history-custom-range__divider {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 44rpx;
  height: 44rpx;
  margin: 0 2rpx;
  font-size: 24rpx;
  color: #a29185;
  background: rgb(167 69 50 / 5%);
  border-radius: 50%;
}

.history-summary {
  position: relative;
  display: flex;
  align-items: center;
  min-height: 146rpx;
  padding: 18rpx 18rpx 16rpx 22rpx;
  overflow: hidden;
  background:
    linear-gradient(108deg, rgb(255 255 255 / 78%) 0%, rgb(255 253 251 / 62%) 52%, rgb(255 246 237 / 44%) 100%);
  border: 1rpx solid rgb(255 255 255 / 80%);
  border-radius: 26rpx;
  box-shadow: 0 18rpx 38rpx rgb(172 111 72 / 7%);
}

.history-summary__glow {
  position: absolute;
  right: -64rpx;
  bottom: -110rpx;
  width: 360rpx;
  height: 320rpx;
  background: radial-gradient(ellipse, rgb(255 203 159 / 38%) 0%, rgb(255 232 214 / 0%) 70%);
  border-radius: 50%;
}

.history-summary__stats {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  width: 76%;
}

.history-summary__item {
  flex: 1;
  min-width: 0;
}

.history-summary__item--count {
  display: flex;
  flex: 0 0 34%;
  flex-direction: column;
  align-items: center;
}

.history-summary__item--count .history-summary__label {
  justify-content: center;
}

.history-summary__item--count .history-summary__value {
  text-align: center;
}

.history-summary__label {
  display: flex;
  gap: 8rpx;
  align-items: center;
  font-size: 27rpx;
  font-weight: 500;
  line-height: 1.2;
  color: #3f3b38;
  white-space: nowrap;
}

.history-summary__icon {
  flex: none;
  width: 37rpx;
  height: 37rpx;
}

.history-summary__value {
  margin-top: 2rpx;
  overflow: hidden;
  font-size: 52rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.08;
  color: #bf452d;
  letter-spacing: -1rpx;
  white-space: nowrap;
}

.history-summary__unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #4f4944;
  letter-spacing: 0;
}

.history-summary__divider {
  flex: none;
  width: 1rpx;
  height: 84rpx;
  margin: 0 18rpx;
  background: rgb(167 69 50 / 18%);
}

.history-summary__truck {
  position: absolute;
  right: -4rpx;
  bottom: 0;
  z-index: 0;
  width: 244rpx;
  height: 132rpx;
  filter: saturate(1.22) contrast(1.04) brightness(1.03);
}

.history-empty {
  padding: 72rpx 28rpx;
  margin-top: 18rpx;
  text-align: center;
  background: rgb(255 255 255 / 74%);
  border: 1rpx solid rgb(255 255 255 / 78%);
  border-radius: 28rpx;
  box-shadow: 0 14rpx 34rpx rgb(178 118 78 / 6%);
}

.history-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--fc-text);
}

.history-empty-hint {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--fc-text-secondary);
}

.record-list {
  display: block;
}

.record-card {
  position: relative;
  display: block;
  margin: 0 0 12rpx;
  overflow: hidden;
  background:
    radial-gradient(120% 160% at 105% 110%, rgb(255 215 183 / 32%) 0%, rgb(255 240 228 / 0%) 54%),
    linear-gradient(108deg, #fff 0%, #fffdfb 64%, #fff8f0 100%);
  border: 1rpx solid rgb(255 255 255 / 86%);
  border-radius: 24rpx;
  box-shadow: 0 16rpx 34rpx rgb(178 118 78 / 8%);
}

.record-card::before {
  position: absolute;
  right: -80rpx;
  bottom: -86rpx;
  width: 370rpx;
  height: 250rpx;
  content: '';
  background: radial-gradient(ellipse, rgb(255 210 174 / 58%) 0%, rgb(255 238 225 / 0%) 70%);
  border-radius: 50%;
}

.record-card::after {
  position: absolute;
  top: 106rpx;
  left: 150rpx;
  width: 410rpx;
  height: 110rpx;
  content: '';
  background: radial-gradient(ellipse, rgb(255 246 236 / 92%) 0%, rgb(255 246 236 / 0%) 72%);
  border-radius: 50%;
  transform: rotate(-6deg);
}

.record-type {
  position: absolute;
  top: 0;
  left: 0;
  z-index: 3;
  display: block;
  width: 96rpx;
  height: 150rpx;
}

.record-body {
  position: relative;
  z-index: 1;
  padding: 14rpx 18rpx;
}

.record-head {
  padding-left: 132rpx;
}

.record-top {
  display: flex;
  gap: 12rpx;
  align-items: center;
  justify-content: space-between;
  min-height: 42rpx;
}

.record-time {
  display: flex;
  gap: 8rpx;
  align-items: center;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  line-height: 1.25;
  color: #7c746e;
  white-space: nowrap;
}

.record-time__icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.record-status {
  box-sizing: border-box;
  display: inline-flex;
  flex-shrink: 0;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  height: 46rpx;
  padding: 0 15rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  white-space: nowrap;
  border-radius: 999rpx;
}

.record-status__icon {
  flex: none;
  width: 32rpx;
  height: 32rpx;
}

.record-status--pending {
  color: #b8462d;
  background: #fbe8da;
}

.record-status--completed {
  color: #27865b;
  background: #e2f5e7;
}

.record-status--muted {
  color: #777674;
  background: #f1ede7;
}

.record-main {
  display: flex;
  gap: 10rpx;
  align-items: flex-end;
  justify-content: space-between;
  margin-top: 0;
}

.record-main__value {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}

.record-weight-line {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.record-weight {
  font-size: 78rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
  line-height: 1.04;
  color: #c3462f;
  letter-spacing: -2rpx;
}

.record-unit {
  margin-left: 8rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: #3f3b38;
}

.record-net-label {
  flex: none;
  padding: 2rpx 12rpx;
  margin: 0 0 2rpx;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1.3;
  color: #7a5a2e;
  background: #f9e9da;
  border-radius: 8rpx;
}

.print-btn {
  box-sizing: border-box;
  display: flex;
  flex-shrink: 0;
  gap: 6rpx;
  align-items: center;
  justify-content: center;
  min-height: 70rpx;
  padding: 0 24rpx;
  font-size: 25rpx;
  font-weight: 700;
  line-height: 1;
  color: #fff;
  background: linear-gradient(180deg, #cf5637 0%, #a74532 100%);
  border-radius: 999rpx;
  box-shadow: 0 6rpx 14rpx rgb(167 69 50 / 22%);
}

.print-btn:active {
  opacity: 0.9;
  transform: scale(0.97);
}

.print-icon {
  flex: none;
  width: 30rpx;
  height: 30rpx;
  filter: brightness(0) invert(1);
}

.record-hint {
  display: flex;
  gap: 8rpx;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #74665d;
  background: linear-gradient(90deg, rgb(253 237 225 / 96%) 0%, rgb(252 232 217 / 92%) 100%);
  border-radius: 20rpx;
}

.record-hint__icon {
  flex: none;
  width: 28rpx;
  height: 28rpx;
}

.record-compare {
  display: flex;
  align-items: center;
  height: 70rpx;
  padding: 0 10rpx;
  margin-top: 6rpx;
  background: linear-gradient(90deg, rgb(253 237 225 / 96%) 0%, rgb(252 232 217 / 92%) 100%);
  border-radius: 20rpx;
}

.compare-item {
  display: flex;
  flex: 1;
  gap: 8rpx;
  align-items: baseline;
  justify-content: center;
  min-width: 0;
}

.compare-label {
  font-size: 25rpx;
  color: #6f655e;
  white-space: nowrap;
}

.compare-value {
  font-size: 32rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: #25282b;
  white-space: nowrap;
}

.compare-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3f3b38;
}

.compare-divider {
  flex: none;
  width: 1rpx;
  height: 38rpx;
  background: rgb(167 69 50 / 28%);
}

.history-more {
  display: flex;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  padding: 18rpx 0 10rpx;
  font-size: 24rpx;
  color: #8a7d73;
}

.history-more__arrow {
  width: 14rpx;
  height: 14rpx;
  border-right: 3rpx solid #bcaa9d;
  border-bottom: 3rpx solid #bcaa9d;
  transform: rotate(45deg) translateY(-2rpx);
}

.history-end__icon {
  position: relative;
  flex: none;
  width: 30rpx;
  height: 30rpx;
  border: 2rpx solid #d3c5b9;
  border-radius: 50%;
}

.history-end__icon::after {
  position: absolute;
  top: 7rpx;
  left: 7rpx;
  width: 12rpx;
  height: 6rpx;
  content: '';
  border-bottom: 2rpx solid #b39c8c;
  border-left: 2rpx solid #b39c8c;
  transform: rotate(-45deg);
}

/* 底部导航 */
.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 20;
  display: flex;
  padding: 6rpx 16rpx 0;
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
  background: rgb(255 255 255 / 98%);
  border: 1rpx solid rgb(255 255 255 / 86%);
  border-bottom: 0;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -14rpx 34rpx rgb(129 74 48 / 7%);
}

.nav-item,
.nav-exit {
  position: relative;
  display: flex;
  flex: 1;
  gap: 10rpx;
  align-items: center;
  justify-content: center;
  min-height: 98rpx;
  font-size: 30rpx;
  color: #777674;
}

.nav-item + .nav-item,
.nav-exit {
  border-left: 1rpx solid rgb(167 69 50 / 10%);
}

.nav-item--active {
  font-weight: 700;
  color: #c0442a;
}

.nav-item--active::after {
  position: absolute;
  bottom: 8rpx;
  left: 50%;
  width: 54rpx;
  height: 5rpx;
  content: '';
  background: #c0442a;
  border-radius: 999rpx;
  transform: translateX(-50%);
}

.nav-exit {
  color: #777674;
}

/* 小屏压缩，确保过磅页不滚动 */
@media (max-height: 700px) {
  .identity-bar {
    min-height: 92rpx;
    padding: 12rpx 20rpx;
  }

  .identity-value {
    font-size: 40rpx;
  }

  .identity-plate-text {
    font-size: 32rpx;
  }

  .identity-driver-icon {
    width: 40rpx;
    height: 40rpx;
  }

  .reading-card {
    padding: 18rpx 24rpx 16rpx;
  }

  .reading-value {
    font-size: 100rpx;
  }

  .qr-frame {
    width: 43vw;
    max-width: 330rpx;
    height: 43vw;
    max-height: 330rpx;
  }

  .qr-card {
    padding: 20rpx 24rpx;
  }
}

@media (max-width: 340px) {
  .identity-bar {
    gap: 12rpx;
    padding: 12rpx 16rpx;
  }

  .identity-value {
    font-size: 40rpx;
  }

  .identity-plate {
    max-width: 240rpx;
    padding: 8rpx 14rpx;
  }

  .identity-plate-text {
    font-size: 32rpx;
  }

  .reading-value {
    font-size: 100rpx;
  }

  .qr-frame {
    width: 48vw;
    height: 48vw;
  }
}

/* 320px 窄屏：压缩筛选项与卡片横向占用，避免状态与时间挤压 */
@media (max-width: 350px) {
  .history-filters {
    gap: 20rpx;
  }

  .history-range {
    flex-basis: 236rpx;
    gap: 8rpx;
    padding: 0 14rpx;
  }

  .history-range__label,
  .history-type-tab {
    font-size: 26rpx;
  }

  .history-summary__stats {
    width: 78%;
  }

  .history-summary__item--count {
    flex-basis: 34%;
  }

  .history-date-picker__inner {
    padding: 6rpx 10rpx;
  }

  .history-date-picker__value {
    font-size: 26rpx;
  }

  .history-summary__value {
    font-size: 46rpx;
  }

  .history-summary__truck {
    width: 214rpx;
    height: 116rpx;
  }

  .record-head {
    padding-left: 112rpx;
  }

  .record-type {
    width: 88rpx;
    height: 138rpx;
  }

  .record-time {
    font-size: 24rpx;
  }

  .record-status {
    padding: 0 12rpx;
    font-size: 24rpx;
  }

  .record-weight {
    font-size: 74rpx;
  }

  .print-btn {
    min-height: 64rpx;
    padding: 0 18rpx;
    font-size: 24rpx;
  }
}
