.weigh-page {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(200rpx + env(safe-area-inset-bottom));
  background: var(--fc-bg);
}

.head {
  display: flex;
  gap: 20rpx;
  align-items: baseline;
  padding: 8rpx 8rpx 24rpx;
}

.name {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--fc-text-secondary);
}

.plate {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--fc-text);
  letter-spacing: 2rpx;
}

.weight-card {
  padding: 36rpx 32rpx;
  text-align: center;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.weight-value {
  font-size: 128rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.05;
  color: var(--fc-brand);
}

.weight-unit {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--fc-text);
}

.status {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.status-ok {
  color: var(--fc-success);
  background: var(--fc-success-soft);
}

.status-bad {
  color: var(--fc-error);
  background: var(--fc-error-soft);
}

.action-card,
.result-card {
  padding: 32rpx;
  margin-top: 24rpx;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.action-hint {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--fc-text-secondary);
  text-align: center;
}

.pending-title,
.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fc-text);
  text-align: center;
}

.pending-weight,
.result-net {
  margin-top: 12rpx;
  font-size: 88rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--fc-brand);
  text-align: center;
}

.pending-unit,
.result-unit {
  margin-left: 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fc-text);
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  background: var(--fc-brand);
  border-radius: 28rpx;
}

.primary-btn--disabled {
  opacity: 0.45;
}

.text-btn {
  padding: 16rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--fc-text-secondary);
  text-align: center;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 30rpx;
  border-top: 1rpx solid var(--fc-border);
}

.result-k {
  color: var(--fc-text-secondary);
}

.result-v {
  font-weight: 500;
  color: var(--fc-text);
}

.action-card .primary-btn,
.result-card .primary-btn {
  margin-top: 28rpx;
}

.history-count {
  padding: 4rpx 8rpx 20rpx;
  font-size: 26rpx;
  color: var(--fc-text-secondary);
}

.history-empty {
  padding: 96rpx 32rpx;
  text-align: center;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.history-empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fc-text);
}

.history-empty-hint {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--fc-text-secondary);
}

.history-card {
  padding: 28rpx 32rpx;
  margin-bottom: 20rpx;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 28rpx;
}

.history-main {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.history-net {
  font-size: 60rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--fc-brand);
}

.history-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 500;
  color: var(--fc-text);
}

.history-date {
  font-size: 26rpx;
  color: var(--fc-text-secondary);
}

.history-detail {
  display: flex;
  gap: 32rpx;
  margin-top: 16rpx;
  font-size: 28rpx;
  color: var(--fc-text-secondary);
}

.history-ticket {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: var(--fc-text-placeholder);
  word-break: break-all;
}

.bottom-nav {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 10;
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  background: var(--fc-surface);
  border-top: 1rpx solid var(--fc-border);
}

.nav-item {
  position: relative;
  flex: 1;
  padding: 28rpx 0 24rpx;
  font-size: 32rpx;
  color: var(--fc-text-secondary);
  text-align: center;
}

.nav-item--active {
  font-weight: 600;
  color: var(--fc-brand);
}

.nav-item--active::after {
  position: absolute;
  bottom: 10rpx;
  left: 50%;
  width: 48rpx;
  height: 6rpx;
  content: '';
  background: var(--fc-brand);
  border-radius: 999rpx;
  transform: translateX(-50%);
}

.nav-exit {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: var(--fc-text-placeholder);
}
