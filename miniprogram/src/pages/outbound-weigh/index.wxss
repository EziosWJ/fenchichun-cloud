.weigh-page {
  min-height: 100vh;
  padding: 32rpx 24rpx calc(48rpx + env(safe-area-inset-bottom));
  background: var(--fc-bg);
}

.head {
  padding: 8rpx 8rpx 24rpx;
}

.plate {
  font-size: 64rpx;
  font-weight: 700;
  color: var(--fc-text);
  letter-spacing: 2rpx;
}

.meta {
  margin-top: 8rpx;
  font-size: 28rpx;
  color: var(--fc-text-secondary);
}

.weight-card {
  padding: 36rpx 32rpx;
  text-align: center;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.weight-label {
  font-size: 30rpx;
  color: var(--fc-text-secondary);
}

.weight-value {
  margin-top: 16rpx;
  font-size: 128rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  line-height: 1.05;
  color: var(--fc-brand);
}

.weight-unit {
  margin-left: 12rpx;
  font-size: 40rpx;
  font-weight: 500;
  color: var(--fc-text);
}

.status {
  display: inline-block;
  padding: 10rpx 24rpx;
  margin-top: 20rpx;
  font-size: 26rpx;
  border-radius: 999rpx;
}

.status-ok {
  color: var(--fc-success);
  background: var(--fc-success-soft);
}

.status-bad {
  color: var(--fc-error);
  background: var(--fc-error-soft);
}

.action-card,
.result-card {
  padding: 32rpx;
  margin-top: 24rpx;
  background: var(--fc-surface);
  border: 1rpx solid var(--fc-border);
  border-radius: 32rpx;
}

.action-hint {
  margin-bottom: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--fc-text-secondary);
  text-align: center;
}

.pending-title,
.result-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--fc-text);
  text-align: center;
}

.pending-weight,
.result-net {
  margin-top: 12rpx;
  font-size: 88rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
  color: var(--fc-brand);
  text-align: center;
}

.pending-unit,
.result-unit {
  margin-left: 10rpx;
  font-size: 32rpx;
  font-weight: 500;
  color: var(--fc-text);
}

.pending-time {
  margin-bottom: 24rpx;
  font-size: 26rpx;
  color: var(--fc-text-secondary);
  text-align: center;
}

.primary-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 112rpx;
  margin-top: 8rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
  background: var(--fc-brand);
  border-radius: 28rpx;
}

.primary-btn--disabled {
  opacity: 0.45;
}

.text-btn {
  padding: 16rpx;
  margin-top: 20rpx;
  font-size: 28rpx;
  color: var(--fc-text-secondary);
  text-align: center;
}

.result-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  font-size: 30rpx;
  border-top: 1rpx solid var(--fc-border);
}

.result-k {
  color: var(--fc-text-secondary);
}

.result-v {
  font-weight: 500;
  color: var(--fc-text);
}

.result-card .primary-btn {
  margin-top: 28rpx;
}

.exit-link {
  padding: 20rpx;
  margin-top: 48rpx;
  font-size: 26rpx;
  color: var(--fc-text-placeholder);
  text-align: center;
}
