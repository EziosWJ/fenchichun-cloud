<view class="weigh-page">
  <view class="head">
    <view class="plate">{{plate}}</view>
    <view class="meta">{{partyName}} · {{siteName}}</view>
  </view>

  <block wx:if="{{tab === 'weigh'}}">
    <loading-state wx:if="{{loading}}" text="正在加载出库信息" />
    <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
    <block wx:else>
      <view class="weight-card">
        <view class="weight-label">当前地磅读数</view>
        <view class="weight-value">{{weightText}}<text class="weight-unit">吨</text></view>
        <view class="status {{available ? 'status-ok' : 'status-bad'}}">
          {{statusText}}<text wx:if="{{mock}}"> · 模拟读数</text>
        </view>
      </view>

      <view wx:if="{{result}}" class="result-card">
        <view class="result-title">过磅完成</view>
        <view class="result-net">{{netText}}<text class="result-unit">吨</text></view>
        <view class="result-row"><text class="result-k">磅单号</text><text class="result-v">{{result.ticketNo}}</text></view>
        <view class="result-row"><text class="result-k">首磅</text><text class="result-v">{{resultFirstText}} 吨</text></view>
        <view class="result-row"><text class="result-k">回磅</text><text class="result-v">{{resultSecondText}} 吨</text></view>
        <view class="primary-btn" bindtap="finish">完成，继续下一车</view>
      </view>

      <view wx:elif="{{pending}}" class="action-card">
        <view class="pending-title">首磅已记录</view>
        <view class="pending-weight">{{firstText}}<text class="pending-unit">吨</text></view>
        <view class="pending-time">首磅时间 {{firstTime}}</view>
        <view class="action-hint">卸货完成后请再次上磅，点击回磅</view>
        <view class="primary-btn {{available && !busy ? '' : 'primary-btn--disabled'}}" bindtap="doSecond">回磅</view>
        <view class="text-btn" bindtap="cancelFirst">取消首磅</view>
      </view>

      <view wx:else class="action-card">
        <view class="action-hint">车辆上磅停稳后，点击记录首磅</view>
        <view class="primary-btn {{available && !busy ? '' : 'primary-btn--disabled'}}" bindtap="doFirst">首磅</view>
      </view>
    </block>
  </block>

  <block wx:else>
    <loading-state wx:if="{{historyLoading}}" text="正在加载过磅历史" />
    <error-state wx:elif="{{historyError}}" text="{{historyError}}" bind:retry="loadHistory" />
    <view wx:elif="{{history.length === 0}}" class="history-empty">
      <view class="history-empty-title">暂无过磅记录</view>
      <view class="history-empty-hint">完成回磅后，这里会显示你的过磅单</view>
    </view>
    <block wx:else>
      <view class="history-count">共 {{history.length}} 条记录</view>
      <view wx:for="{{history}}" wx:key="ticketNo" class="history-card">
        <view class="history-main">
          <view class="history-net">{{item.netText}}<text class="history-unit">吨</text></view>
          <view class="history-date">{{item.dateText}}</view>
        </view>
        <view class="history-detail">
          <text>首磅 {{item.firstText}} 吨</text>
          <text>回磅 {{item.secondText}} 吨</text>
        </view>
        <view class="history-ticket">{{item.ticketNo}}</view>
      </view>
    </block>
  </block>

  <view class="exit-link" bindtap="exit">退出登录</view>

  <view class="bottom-nav">
    <view class="nav-item {{tab === 'weigh' ? 'nav-item--active' : ''}}" data-tab="weigh" bindtap="changeTab">过磅</view>
    <view class="nav-item {{tab === 'history' ? 'nav-item--active' : ''}}" data-tab="history" bindtap="changeTab">历史记录</view>
  </view>
</view>
