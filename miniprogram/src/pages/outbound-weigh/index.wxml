<view class="weigh-page {{tab === 'weigh' ? 'weigh-page--fixed' : 'weigh-page--history'}}">
  <image class="top-bg" src="/assets/backgrounds/top_warm_wave_bg.png" mode="scaleToFill" aria-hidden="true" />
  <view wx:if="{{tab === 'history'}}" class="history-backdrop" aria-hidden="true">
    <view class="history-backdrop__glow history-backdrop__glow--right"></view>
    <view class="history-backdrop__glow history-backdrop__glow--left"></view>
  </view>
  <view class="custom-nav" style="padding-top: {{statusBarHeight}}px;">
    <view class="custom-nav__bar" style="height: {{navBarHeight}}px;">
      <view wx:if="{{tab === 'history'}}" class="custom-nav__back" bindtap="backToWeigh" hover-class="custom-nav__back--hover" aria-role="button" aria-label="返回酒糟过磅">
        <view class="custom-nav__arrow" aria-hidden="true"></view>
      </view>
      <view class="custom-nav__title">{{tab === 'history' ? '历史记录' : '酒糟过磅'}}</view>
    </view>
  </view>
  <view class="weigh-content">
    <view class="nav-spacer" style="height: {{statusBarHeight + navBarHeight}}px;" aria-hidden="true"></view>
    <view class="weigh-main">
      <view wx:if="{{tab === 'weigh'}}" class="identity-bar">
        <view class="identity-driver">
          <image class="identity-driver-icon" src="/assets/icons/driver_outline.png" mode="aspectFit" aria-hidden="true" />
          <text class="identity-value">{{partyName || '—'}}</text>
        </view>
        <view class="identity-divider" aria-hidden="true"></view>
        <view class="identity-plate">
          <t-icon name="vehicle" size="30rpx" color="#ffffff" aria-hidden="true" />
          <text class="identity-plate-text">{{plate || '—'}}</text>
        </view>
      </view>

      <block wx:if="{{tab === 'weigh'}}">
        <loading-state wx:if="{{loading}}" text="正在加载出库信息" />
        <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
        <block wx:else>
          <view class="reading-card">
            <view class="reading-head">
              <view class="reading-title">
                <view class="reading-icon" aria-hidden="true">
                  <view class="reading-icon__beam"></view>
                  <view class="reading-icon__post"></view>
                  <view class="reading-icon__pan reading-icon__pan--left"></view>
                  <view class="reading-icon__pan reading-icon__pan--right"></view>
                </view>
                <text class="reading-label">当前地磅读数</text>
              </view>
              <text wx:if="{{mock}}" class="mock-badge">模拟</text>
            </view>
            <view class="reading-value-row">
              <text class="reading-value">{{reading ? weightText : '--.---'}}</text>
              <text class="reading-unit">吨</text>
            </view>
            <view class="reading-status-row">
              <view class="reading-status-line" aria-hidden="true"></view>
              <view class="reading-status reading-status--{{readingState}}" aria-role="status">
                <t-icon wx:if="{{readingState === 'ok'}}" name="check-circle-filled" size="30rpx" color="#27865b" aria-hidden="true" />
                <t-icon wx:elif="{{readingState === 'warn'}}" name="time" size="30rpx" color="#8a5a12" aria-hidden="true" />
                <t-icon wx:else name="error-circle-filled" size="30rpx" color="#b33f35" aria-hidden="true" />
                <text>{{readingHint}}</text>
              </view>
              <view class="reading-status-line" aria-hidden="true"></view>
            </view>
          </view>

          <view wx:if="{{current && current.status === 'completed'}}" class="result-card">
            <view class="result-heading">
              <t-icon name="check-circle-filled" size="48rpx" color="#27865b" aria-hidden="true" />
              <text class="result-title">厂端已出单</text>
            </view>
            <view class="result-net">{{netText}}<text class="result-unit">吨</text></view>
            <view class="result-row"><text class="result-k">正式磅单号</text><text class="result-v">{{ticketText || '待同步'}}</text></view>
            <view class="result-row"><text class="result-k">{{current.source === 'mobile_direct' ? '首磅毛重' : '首磅皮重'}}</text><text class="result-v">{{firstText}} 吨</text></view>
            <view class="result-row"><text class="result-k">{{current.source === 'mobile_direct' ? '回磅皮重' : '回磅毛重'}}</text><text class="result-v">{{secondText}} 吨</text></view>
            <view wx:if="{{message}}" class="result-message">{{message}}</view>
            <button class="primary-btn" bindtap="finish">完成，继续下一车</button>
          </view>

          <view wx:elif="{{qr}}" class="qr-card">
            <view class="card-heading">
              <image class="card-heading__icon" src="/assets/icons/qr_outline.png" mode="aspectFit" aria-hidden="true" />
              <text class="card-title">{{qrTitle}}</text>
            </view>
            <view class="qr-frame">
              <view class="qr-corner qr-corner--tl" aria-hidden="true"></view>
              <view class="qr-corner qr-corner--tr" aria-hidden="true"></view>
              <view class="qr-corner qr-corner--bl" aria-hidden="true"></view>
              <view class="qr-corner qr-corner--br" aria-hidden="true"></view>
              <image class="qr-image" src="{{qr.image}}" mode="aspectFit" aria-label="{{qrTitle}}" />
              <view class="qr-refresh" bindtap="regenerateQR" aria-role="button" aria-label="重新生成二维码">
                <t-loading wx:if="{{busy}}" theme="circular" size="44rpx" />
                <image wx:else class="qr-refresh-icon" src="/assets/icons/refresh_outline.png" mode="aspectFit" aria-hidden="true" />
              </view>
            </view>
            <view class="qr-expiry">
              <t-icon name="time" size="28rpx" color="#a74532" aria-hidden="true" />
              <text>有效期至</text>
              <text class="qr-expiry__value">{{qrExpireText}}</text>
            </view>
            <view class="qr-weight">
              <text class="qr-weight__label">{{qr.action === 'first' ? '首磅皮重' : '回磅毛重'}}</text>
              <text class="qr-weight__value">{{qr.action === 'first' ? (firstText || '—') : (secondText || '—')}}<text class="qr-weight__unit">吨</text></text>
            </view>
          </view>

          <view wx:elif="{{current && (current.status === 'first_scanning' || current.status === 'second_scanning')}}" class="action-card processing-card">
            <t-loading theme="circular" size="56rpx" />
            <view class="pending-title">{{statusLabel}}</view>
            <view class="action-hint">厂端正在采集重量和抓拍，请保持车辆停稳。</view>
            <view wx:if="{{message}}" class="result-message">{{message}}</view>
          </view>

          <view wx:elif="{{current && current.status === 'first_recorded'}}" class="action-card">
            <view class="action-heading">
              <t-icon name="check-circle-filled" size="44rpx" color="#27865b" aria-hidden="true" />
              <text class="pending-title">首磅已确认</text>
            </view>
            <view class="qr-weight">
              <text class="qr-weight__label">首磅皮重</text>
              <text class="qr-weight__value">{{firstText || '—'}}<text class="qr-weight__unit">吨</text></text>
            </view>
            <button class="primary-btn {{busy ? 'primary-btn--disabled' : ''}}" bindtap="doSecond">回磅</button>
          </view>

          <view wx:elif="{{current && (current.status === 'first_qr_ready' || current.status === 'second_qr_ready')}}" class="action-card">
            <view wx:if="{{message}}" class="result-message">{{message}}</view>
            <view class="primary-btn {{busy ? 'primary-btn--disabled' : ''}}" bindtap="regenerateQR">{{current.status === 'first_qr_ready' ? '生成首磅二维码' : '生成回磅二维码'}}</view>
          </view>

          <view wx:elif="{{current && (current.status === 'terminated' || current.status === 'expired' || current.status === 'cancelled')}}" class="action-card">
            <view class="pending-title">{{statusLabel}}</view>
            <view wx:if="{{message}}" class="result-message">{{message}}</view>
            <button class="primary-btn {{busy ? 'primary-btn--disabled' : ''}}" bindtap="doFirst">重新首磅</button>
          </view>

          <view wx:else class="action-card idle-card">
            <view class="idle-copy">
              <text class="idle-title">开始首磅</text>
              <text class="idle-desc">空车停稳后生成首磅二维码</text>
            </view>
            <button class="primary-btn idle-btn {{busy ? 'primary-btn--disabled' : ''}}" bindtap="doFirst">首磅</button>
          </view>
        </block>
      </block>

      <block wx:else>
        <view class="history-filters {{historyRange === 'custom' ? 'history-filters--custom' : ''}}">
          <view class="history-range" bindtap="changeHistoryRange" aria-role="button" aria-label="选择日期范围">
            <image class="history-range__icon" src="/assets/history/calendar.png" mode="aspectFit" aria-hidden="true" />
            <text class="history-range__label">{{historyRangeLabel}}</text>
            <view class="history-range__caret" aria-hidden="true"></view>
          </view>
          <view class="history-type-tabs" aria-role="tablist">
            <view class="history-type-tab {{historyType === 'all' ? 'is-active' : ''}}" data-type="all" bindtap="changeHistoryType" aria-role="tab" aria-selected="{{historyType === 'all'}}">全部</view>
            <view class="history-type-tab {{historyType === 'first' ? 'is-active' : ''}}" data-type="first" bindtap="changeHistoryType" aria-role="tab" aria-selected="{{historyType === 'first'}}">首磅</view>
            <view class="history-type-tab {{historyType === 'second' ? 'is-active' : ''}}" data-type="second" bindtap="changeHistoryType" aria-role="tab" aria-selected="{{historyType === 'second'}}">回磅</view>
          </view>
        </view>
        <view wx:if="{{historyRange === 'custom'}}" class="history-custom-range">
          <picker class="history-date-picker history-date-picker--start" mode="date" value="{{historyFrom}}" bindchange="changeHistoryFrom">
            <view class="history-date-picker__inner" hover-class="history-date-picker__inner--hover">
              <view class="history-date-picker__head">
                <image class="history-date-picker__icon" src="/assets/history/calendar.png" mode="aspectFit" aria-hidden="true" />
                <text class="history-date-picker__label">开始日期</text>
              </view>
              <text class="history-date-picker__value">{{historyFrom || '请选择'}}</text>
            </view>
          </picker>
          <view class="history-custom-range__divider" aria-hidden="true">
            <text>至</text>
          </view>
          <picker class="history-date-picker" mode="date" value="{{historyTo}}" bindchange="changeHistoryTo">
            <view class="history-date-picker__inner" hover-class="history-date-picker__inner--hover">
              <view class="history-date-picker__head">
                <image class="history-date-picker__icon" src="/assets/history/calendar.png" mode="aspectFit" aria-hidden="true" />
                <text class="history-date-picker__label">结束日期</text>
              </view>
              <text class="history-date-picker__value">{{historyTo || '请选择'}}</text>
            </view>
          </picker>
        </view>

        <view class="history-summary">
          <view class="history-summary__glow" aria-hidden="true"></view>
          <view class="history-summary__stats">
            <view class="history-summary__item history-summary__item--count">
              <view class="history-summary__label">
                <image class="history-summary__icon" src="/assets/history/document.png" mode="aspectFit" aria-hidden="true" />
                <text>总单据数</text>
              </view>
              <view class="history-summary__value">{{historyTotal}}<text class="history-summary__unit">单</text></view>
            </view>
            <view class="history-summary__divider" aria-hidden="true"></view>
            <view class="history-summary__item history-summary__item--net">
              <view class="history-summary__label">
                <image class="history-summary__icon" src="/assets/history/scale.png" mode="aspectFit" aria-hidden="true" />
                <text>总净重</text>
              </view>
              <view class="history-summary__value">{{historyTotalNetText}}<text class="history-summary__unit">吨</text></view>
            </view>
          </view>
          <image class="history-summary__truck" src="/assets/history/truck.png" mode="aspectFit" aria-hidden="true" />
        </view>

        <loading-state wx:if="{{historyLoading}}" text="正在加载过磅历史" />
        <error-state wx:elif="{{historyError}}" text="{{historyError}}" bind:retry="retryHistory" />
        <view wx:elif="{{history.length === 0}}" class="history-empty">
          <view class="history-empty-title">暂无过磅记录</view>
          <view class="history-empty-hint">完成首磅、回磅并扫码后，这里会显示厂端正式磅单。</view>
        </view>
        <block wx:else>
          <view class="record-list">
            <view wx:for="{{history}}" wx:key="id" class="record-card">
              <image class="record-type" src="{{item.type === 'first' ? '/assets/history/tag-first.png' : '/assets/history/tag-second.png'}}" mode="aspectFit" aria-label="{{item.type === 'first' ? '首磅' : '回磅'}}" />
              <view class="record-body">
                <view class="record-head">
                  <view class="record-top">
                    <view class="record-time">
                      <image class="record-time__icon" src="/assets/history/clock.png" mode="aspectFit" aria-hidden="true" />
                      <text>{{item.dateText}}</text>
                    </view>
                    <view class="record-status record-status--{{item.statusKind}}">
                      <image wx:if="{{item.statusKind === 'completed'}}" class="record-status__icon" src="/assets/history/status-check.png" mode="aspectFit" aria-hidden="true" />
                      <image wx:elif="{{item.statusKind === 'pending'}}" class="record-status__icon" src="/assets/history/status-clock.png" mode="aspectFit" aria-hidden="true" />
                      <text>{{item.statusLabel}}</text>
                    </view>
                  </view>
                  <view class="record-main">
                    <view class="record-main__value">
                      <text wx:if="{{item.showNetLabel}}" class="record-net-label">净重</text>
                      <view class="record-weight-line">
                        <text class="record-weight">{{item.mainText}}</text>
                        <text class="record-unit">吨</text>
                      </view>
                    </view>
                    <view wx:if="{{item.printable}}" class="print-btn" catchtap="printTicket" data-id="{{item.id}}" aria-role="button" aria-label="打印单据">
                      <image class="print-icon" src="/assets/history/print.png" mode="aspectFit" aria-hidden="true" />
                      <text>打印单据</text>
                    </view>
                  </view>
                </view>
                <view wx:if="{{item.infoText}}" class="record-hint">
                  <image class="record-hint__icon" src="/assets/history/status-info.png" mode="aspectFit" aria-hidden="true" />
                  <text>{{item.infoText}}</text>
                </view>
                <view wx:if="{{item.type === 'second'}}" class="record-compare">
                  <view class="compare-item">
                    <text class="compare-label">首磅重量</text>
                    <text class="compare-value">{{item.firstText}}<text class="compare-unit">吨</text></text>
                  </view>
                  <view class="compare-divider" aria-hidden="true"></view>
                  <view class="compare-item">
                    <text class="compare-label">回磅重量</text>
                    <text class="compare-value">{{item.secondText}}<text class="compare-unit">吨</text></text>
                  </view>
                </view>
              </view>
            </view>
          </view>
          <view class="history-more">
            <t-loading wx:if="{{historyLoadingMore}}" theme="circular" size="30rpx" />
            <view wx:elif="{{historyHasMore}}" class="history-more__arrow" aria-hidden="true"></view>
            <view wx:else class="history-end__icon" aria-hidden="true"></view>
            <text wx:if="{{historyLoadingMore}}">正在加载更多</text>
            <text wx:elif="{{historyHasMore}}">上拉加载更多</text>
            <text wx:else>没有更多记录</text>
          </view>
        </block>
      </block>
    </view>
  </view>

  <view class="bottom-nav">
    <view class="nav-item {{tab === 'weigh' ? 'nav-item--active' : ''}}" data-tab="weigh" bindtap="changeTab" aria-role="tab" aria-selected="{{tab === 'weigh'}}">
      <t-icon name="chart" size="38rpx" color="{{tab === 'weigh' ? '#a74532' : '#777674'}}" aria-hidden="true" />
      <text>过磅</text>
    </view>
    <view class="nav-item {{tab === 'history' ? 'nav-item--active' : ''}}" data-tab="history" bindtap="changeTab" aria-role="tab" aria-selected="{{tab === 'history'}}">
      <t-icon name="history" size="38rpx" color="{{tab === 'history' ? '#a74532' : '#777674'}}" aria-hidden="true" />
      <text>历史记录</text>
    </view>
    <view class="nav-exit" bindtap="exit" aria-role="button">
      <t-icon name="logout" size="38rpx" color="#777674" aria-hidden="true" />
      <text>退出登录</text>
    </view>
  </view>
</view>
