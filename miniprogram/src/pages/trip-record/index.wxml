<view class="record-page {{step === 'permit' ? 'record-page--permit' : ''}}">
  <loading-state wx:if="{{loading}}" text="正在加载详情" />
  <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
  <block wx:elif="{{trip}}">
    <block wx:if="{{step === 'permit'}}">
      <view class="permit-sheet">
        <view class="permit-frame">
          <view class="permit-head">
            <view class="permit-brand">
              <view class="permit-logo" aria-hidden="true">
                <view class="permit-logo__chimney"></view>
                <view class="permit-logo__block permit-logo__block--left"></view>
                <view class="permit-logo__block permit-logo__block--mid"></view>
                <view class="permit-logo__block permit-logo__block--right"></view>
                <view class="permit-logo__base"></view>
              </view>
              <view class="permit-name">汾池春酒厂</view>
            </view>
            <view class="permit-no">编号：{{permitView.no}}</view>
          </view>

          <view class="permit-title-row">
            <view class="permit-laurel permit-laurel--left"></view>
            <view class="permit-title">出门证</view>
            <view class="permit-laurel permit-laurel--right"></view>
          </view>
          <view class="permit-title-en">EXIT PERMIT</view>
          <view class="permit-double-rule"></view>

          <view class="permit-table">
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">出门人</view>
              <view class="permit-cell permit-cell--value">{{permitView.driver}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">物品</view>
              <view class="permit-cell permit-cell--value">{{permitView.material}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">供货商</view>
              <view class="permit-cell permit-cell--value">{{permitView.supplier}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">规格</view>
              <view class="permit-cell permit-cell--value">{{permitView.spec}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">数量</view>
              <view class="permit-cell permit-cell--value">{{permitView.quantity}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">车号（型）</view>
              <view class="permit-cell permit-cell--value">{{permitView.plate}}</view>
              <view class="permit-cell permit-cell--label permit-cell--narrow">司机</view>
              <view class="permit-cell permit-cell--value permit-cell--narrow">{{permitView.driver}}</view>
            </view>
            <view class="permit-row">
              <view class="permit-cell permit-cell--label">签发部门</view>
              <view class="permit-cell permit-cell--value">{{permitView.site}}</view>
              <view class="permit-cell permit-cell--label permit-cell--narrow">签发人</view>
              <view class="permit-cell permit-cell--value permit-cell--narrow">{{permitView.issuer}}</view>
            </view>
          </view>

          <view class="permit-footer">
            <view class="permit-plant" aria-hidden="true">
              <view class="permit-plant__silo permit-plant__silo--one"></view>
              <view class="permit-plant__silo permit-plant__silo--two"></view>
              <view class="permit-plant__silo permit-plant__silo--three"></view>
              <view class="permit-plant__house"></view>
            </view>
            <view class="permit-notes">
              <view class="permit-notes__title">注意事项：</view>
              <view>1. 本证为车辆出场凭证，遗失无效。</view>
              <view>2. 请携带本证至门卫处核验后放行。</view>
              <view>3. 涂改、复印无效。</view>
            </view>
            <view class="permit-sign">
              <view class="permit-seal">
                <text class="permit-seal__name">汾池春酒厂</text>
                <text class="permit-seal__star">★</text>
                <text class="permit-seal__text">出门专用章</text>
              </view>
              <view class="permit-date">签发日期：{{permitView.date}}</view>
            </view>
          </view>
        </view>
      </view>
    </block>

    <block wx:else>
      <view class="record-hero record-hero--{{hero.tone || 'default'}} record-hero--size-{{hero.size || 'md'}} {{step === 'ticket' ? 'record-hero--compact' : ''}}">
        <text class="record-hero__watermark">春</text>
        <view class="record-hero__label"><view class="record-hero__dot"></view>{{hero.label}}</view>
        <view class="record-hero__value record-hero__value--{{hero.size || 'md'}}">
          <text>{{hero.value}}</text>
          <text wx:if="{{hero.unit}}" class="record-hero__unit">{{hero.unit}}</text>
        </view>
      </view>

      <view class="record-body">
        <block wx:if="{{step === 'ticket' && ticketView}}">
          <view class="ticket-heading">
            <text>结算</text>
            <text class="ticket-heading__no">{{ticketView.no}}</text>
          </view>
          <view class="field-grid">
            <view wx:for="{{ticketView.rows}}" wx:for-item="row" wx:key="index" class="record-row">
              <view wx:for="{{row}}" wx:for-item="field" wx:key="label" class="record-field {{field.full ? 'record-field--full' : ''}}">
                <text class="record-field__label">{{field.label}}</text>
                <text class="record-field__value record-field__value--{{field.tone || 'default'}} record-field__value--size-{{field.size || 'md'}}">{{field.value}}</text>
              </view>
            </view>
          </view>

          <view class="rule-section">
            <view class="section-heading">扣减规则</view>
            <view wx:for="{{ticketView.rules}}" wx:key="index" class="rule-row">
              <view class="rule-main">
                <text class="rule-title">{{item.title}}</text>
                <text class="rule-meta">{{item.meta}}</text>
              </view>
              <text class="rule-amount">{{item.amount}}</text>
            </view>
            <view wx:if="{{ticketView.ruleEmpty}}" class="rule-empty">{{ticketView.ruleEmpty}}</view>
            <view wx:if="{{ticketView.rules.length}}" class="rule-total">
              <text>合计扣减</text>
              <text>{{ticketView.deductionSigned}}</text>
            </view>
          </view>
        </block>

        <block wx:else>
          <view wx:for="{{sections}}" wx:key="index" class="record-section">
            <view wx:if="{{item.title}}" class="section-heading">{{item.title}}</view>
            <view class="field-grid">
              <view wx:for="{{item.rows}}" wx:for-item="row" wx:key="index" class="record-row">
                <view wx:for="{{row}}" wx:for-item="field" wx:key="label" class="record-field {{field.full ? 'record-field--full' : ''}}">
                  <text class="record-field__label">{{field.label}}</text>
                  <text class="record-field__value record-field__value--{{field.tone || 'default'}} record-field__value--size-{{field.size || 'md'}}">{{field.value}}</text>
                </view>
              </view>
            </view>
          </view>

          <view wx:if="{{step === 'registration' && editable}}" class="record-edit" bindtap="edit">更正登记 ›</view>
        </block>
      </view>
    </block>
  </block>
</view>
