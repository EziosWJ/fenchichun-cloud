<view class="screen">
  <view class="screen-title">选择正式磅单</view>
  <view class="subtle">请核对车牌、货品、供应商及两次过磅信息</view>
  <loading-state wx:if="{{loading}}" text="正在加载磅单" />
  <error-state wx:elif="{{error}}" text="{{error}}" bind:retry="load" />
  <block wx:else>
    <view class="notice ticket-notice">未查到同步磅单不代表现场没有称重，请稍后重试。</view>
    <empty-state wx:if="{{!tickets.length}}" text="暂无可关联的正式磅单"><view class="subtle">演示时可在“我的” → “演示控制台”模拟磅单同步。</view></empty-state>
    <view wx:for="{{tickets}}" wx:key="id" class="detail-card">
      <view class="heading-row"><text class="section-heading">{{item.id}}</text><text class="status">可关联</text></view>
      <view class="detail-row"><text class="detail-label">车牌 / 厂区</text><text class="detail-value">{{item.plate}} / {{item.site}}</text></view>
      <view class="detail-row"><text class="detail-label">货品 / 供应商</text><text class="detail-value">{{item.material}} / {{item.supplier}}</text></view>
      <view class="detail-row"><text class="detail-label">首磅 / 回磅</text><text class="detail-value">{{item.firstAt}} / {{item.secondAt}}</text></view>
      <view class="detail-row"><text class="detail-label">毛重 / 皮重</text><text class="detail-value">{{item.gross}} / {{item.tare}}</text></view>
      <view class="detail-row"><text class="detail-label">实际净重</text><text class="detail-value">{{item.net || '未提供'}}</text></view>
      <view class="detail-row"><text class="detail-label">扣减后重量</text><text class="detail-value">{{item.deducted || '未提供'}}</text></view>
      <view class="button-space"><t-button block theme="primary" variant="outline" data-id="{{item.id}}" disabled="{{confirming}}" bindtap="link">关联此磅单</t-button></view>
    </view>
  </block>
</view>
